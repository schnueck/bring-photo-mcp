# Copy this file to .env locally; keep real values outside Git.
BRING_ENV=test
BRING_EMAIL=
BRING_PASSWORD=
BRING_DEFAULT_LIST=
# Comma-separated list names or UUIDs. Use only dedicated TEST lists in test mode.
BRING_ALLOWED_LISTS=
BRING_LOCALE=de-DE
BRING_TEST_ITEM_PREFIX=MCP-TEST-
# Optional: enables the controlled two-list TEST E2E stages.
BRING_TEST_SECOND_LIST=
